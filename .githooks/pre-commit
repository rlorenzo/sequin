#!/usr/bin/env bash
# Fast pre-commit gate: formatting, lints, shell and workflow lints, typos,
# and the golden-check doctests. Rust tests run in CI (and locally via
# `cargo nextest run`), not here.
set -euo pipefail

export PATH="/opt/homebrew/opt/rustup/bin:/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"

echo "pre-commit: cargo fmt --check"
cargo fmt --all --check

echo "pre-commit: cargo clippy -D warnings (workspace)"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-commit: golden_check.py doctests"
python3 -m doctest scripts/golden_check.py

if command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck"
  shellcheck packaging/macos/*.sh scripts/*.sh .githooks/pre-commit
else
  echo "pre-commit: shellcheck not installed, skipping (brew install shellcheck)"
fi

if command -v actionlint >/dev/null 2>&1; then
  echo "pre-commit: actionlint"
  actionlint -no-color -oneline
else
  echo "pre-commit: actionlint not installed, skipping (brew install actionlint)"
fi

if command -v typos >/dev/null 2>&1; then
  echo "pre-commit: typos"
  typos
else
  echo "pre-commit: typos not installed, skipping (brew install typos-cli)"
fi
