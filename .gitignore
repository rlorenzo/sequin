/target

# never commit photos (privacy) — test data stays local
*.jpg
*.jpeg
*.png
*.heic
arrangement.json
sequin-output/

# ...except the app's own icon assets (shippable, not photos)
!crates/sequin-app/assets/
!crates/sequin-app/assets/*.png

# Signing key material. Nothing here should ever be committed, and an
# accidental `git add -A` from a Downloads-adjacent working copy is exactly
# how it would happen.
*.p8
*.p12
*.cer
*.keychain-db

# OS noise
.DS_Store

# doctest byte-cache from scripts/golden_check.py
__pycache__/

# review-loop scratch artifacts
agent-code-review.md
agent-review-summary.md
