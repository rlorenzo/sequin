/target

# never commit photos (privacy) — test data stays local
*.jpg
*.jpeg
*.png
*.heic
arrangement.json
sequin-output/

# ...except the app's own icon artwork (shippable, not photos). Named path by
# path on purpose. A `**` glob here would re-include every PNG anywhere under
# assets/, which would quietly turn the ban above into a suggestion -- a
# screenshot or a test frame dropped in an assets subdirectory would sail
# through `git add -A`. These two lines are the only PNGs the build needs.
!crates/sequin-app/assets/icon.png
!crates/sequin-app/assets/Sequin.icon/Assets/*.png

# Signing key material. Nothing here should ever be committed, and an
# accidental `git add -A` from a Downloads-adjacent working copy is exactly
# how it would happen.
*.p8
*.p12
*.cer
*.keychain-db

# graphify's local analysis cache -- machine-specific, large, regenerated on
# demand. (boost's .boost/ is excluded per-clone in .git/info/exclude.)
graphify-out/

# OS noise
.DS_Store

# doctest byte-cache from scripts/golden_check.py
__pycache__/

# review-loop scratch artifacts
agent-code-review.md
agent-review-summary.md
